static var _by_name: Dictionary = {}
static var _icons: Dictionary = {}


static func get_anima(id: int) -> Dictionary:
	return ANIMAS[clampi(id, 1, COUNT) - 1]


static func id_of(anima_name: String) -> int:
	if _by_name.is_empty():
		for a in ANIMAS:
			_by_name[a.name] = a.id
	return _by_name.get(anima_name, 0)


## 32x32 sprite for an anima id (cached).
static func icon(id: int) -> AtlasTexture:
	if not _icons.has(id):
		var t := AtlasTexture.new()
		t.atlas = load(ATLAS_PATH)
		t.region = Rect2(((id - 1) % ATLAS_COLUMNS) * CELL, ((id - 1) / ATLAS_COLUMNS) * CELL, CELL, CELL)
		_icons[id] = t
	return _icons[id]
