static var _rows: Dictionary = {}


static func row_of(character_id: String) -> int:
	if _rows.is_empty():
		for c in CAST:
			_rows[c.id] = c.row
	return _rows.get(character_id, 0)


## First frame (facing down, idle) as a 16x16 texture.
static func portrait(character_id: String) -> AtlasTexture:
	var t := AtlasTexture.new()
	t.atlas = load(ATLAS_PATH)
	t.region = Rect2(0, row_of(character_id) * CELL, CELL, CELL)
	return t


static func display_name(character_id: String) -> String:
	for c in CAST:
		if c.id == character_id:
			return c.name
	return character_id
